# Copy to .env for local docker-compose use. NEVER commit a real .env file —
# .gitignore in this repo should (and does, see below) exclude it.
#
# For actual production deployment, these should come from your platform's secrets
# manager (AWS Secrets Manager, Vault, k8s Secrets, etc.), injected as real environment
# variables — not from a file like this at all. This file is for local dev convenience
# only, mirroring the same variable names application-prod.yml requires.

DB_URL=jdbc:postgresql://localhost:5432/logiplatform
DB_USERNAME=logi_app
DB_PASSWORD=change-me-generate-a-real-password

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-secret-at-least-32-bytes-long

NEXT_PUBLIC_API_BASE_URL=https://aal-ocst.onrender.com

# AAL Command Center / air-cargo integrations
AIRCARGO_CARRIER_BASE_URL=
AIRCARGO_CARRIER_API_KEY=
AIRCARGO_CUSTOMS_BASE_URL=
AIRCARGO_CUSTOMS_BROKER_URL=
AIRCARGO_INTEGRATION_API_KEY=
PRICING_AI_ENABLED=false
PRICING_AI_BASE_URL=https://api.openai.com/v1
PRICING_AI_API_KEY=
PRICING_AI_MODEL=gpt-5-mini

# Air cargo provider routing
AIRCARGO_PROVIDER_ENABLED=false
AIRCARGO_PROVIDER_CODE=AUTO
AIRCARGO_GENERIC_PROVIDER_CODE=GENERIC_HTTP

# CargoAi CargoCONNECT
AIRCARGO_CARGOAI_BASE_URL=
AIRCARGO_CARGOAI_SEARCH_PATH=
AIRCARGO_CARGOAI_BOOKING_PATH=
AIRCARGO_CARGOAI_TRACK_PATH=
AIRCARGO_CARGOAI_CANCEL_PATH=
# CargoAi supplies the exact base URL and endpoint paths per AAL account/contract.
# Do not copy guessed endpoint paths from this template.
AIRCARGO_CARGOAI_API_KEY=
AIRCARGO_CARGOAI_USER_EMAIL=
AIRCARGO_CARGOAI_USER_IATA=
AIRCARGO_CARGOAI_USER_CASS=
AIRCARGO_CARGOAI_USER_COUNTRY=RW
AIRCARGO_CARGOAI_COMPANY_NAME=Aviation Africa Logistics Ltd
AIRCARGO_CARGOAI_USER_FIRST_NAME=Operations
AIRCARGO_CARGOAI_USER_LAST_NAME=AAL

# Qatar Airways Cargo direct Availability & Rate API
AIRCARGO_QATAR_ENABLED=false
AIRCARGO_QATAR_BASE_URL=
AIRCARGO_QATAR_AVAILABILITY_PATH=/availability
AIRCARGO_QATAR_AUTH_HEADER=X-API-Key
AIRCARGO_QATAR_API_KEY=
AIRCARGO_QATAR_AUTH_PREFIX=
AIRCARGO_QATAR_ACCOUNT_NUMBER=
AIRCARGO_QATAR_AGENT_IATA=
AIRCARGO_QATAR_AGENT_CASS=
AIRCARGO_QATAR_CUSTOMER_NAME=Aviation Africa Logistics Ltd
AIRCARGO_QATAR_CONTACT_EMAIL=
AIRCARGO_QATAR_PRODUCT_CODE=GCR
AIRCARGO_QATAR_SERVICE_CODE=
AIRCARGO_QATAR_COMMODITY_CODE=
AIRCARGO_QATAR_SEARCH_DAYS=5

# Lufthansa Cargo direct AWB tracking
AIRCARGO_LH_CARGO_ENABLED=false
AIRCARGO_LH_CARGO_BASE_URL=https://api.lufthansa-cargo.com
AIRCARGO_LH_CARGO_TRACKING_PATH=/lhcargo/handling/shipmenttracking/v4/shipment
AIRCARGO_LH_CARGO_API_KEY=

# Financial document archive
FINANCIAL_DOCUMENT_STORAGE_PROVIDER=DATABASE
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FINANCIAL_DOCUMENT_BUCKET=financial-documents
APP_BACKEND_URL=https://aal-a.onrender.com
FINANCE_OVERDUE_REMINDER_CRON=0 0 8 * * *
