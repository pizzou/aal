# ================================
# AAL Logistics Platform - Git Ignore
# ================================

# Environment / secrets
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.secret
secrets/
**/secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Java / Maven
**/target/
**/out/
*.class
*.jar
*.war
*.ear

# Node / Next.js
**/node_modules/
**/.next/
**/out/
**/dist/
*.tsbuildinfo
.npm
.yarn/
.pnpm-store/

# Test / coverage
coverage/
.nyc_output/
**/test-results/
**/playwright-report/

# Logs / runtime files
*.log
logs/
*.pid
*.pid.lock

# Local databases / data generated by development
*.sqlite
*.sqlite3
*.db
pgdata/
**/pgdata/

# Docker local overrides / generated state
docker-compose.override.yml
.docker/

# IDEs / editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary / generated files
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig

# Build / packaging artifacts
*.zip
*.tar
*.tar.gz
release/
releases/

# Local AI/tooling state
.mcp.json
.claude/
.cursor/

# Keep important examples/templates tracked
!.env.example
!**/*.example
!**/*.template
